{
  "name": "portfolio-canvas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "seed:reset": "npm run seed -w server -- --reset"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
